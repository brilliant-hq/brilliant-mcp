{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "design.brilliant/mcp",
  "title": "Brilliant Design",
  "description": "Design canvas for coding agents: real editable vectors, auto layout, components, export to code.",
  "version": "0.1.11",
  "websiteUrl": "https://brilliant.design/docs/agents/overview",
  "icons": [
    {
      "src": "https://brilliant.design/images/brilliant-app-icon.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@brilliant-hq/mcp",
      "version": "0.1.11",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
